{
  "schema_version": "live-report/1",
  "title": "Continuous refresh window",
  "origin": "https://appliance.example.com",
  "test_type": "ContinuousTest",
  "rolling_hours": 24,
  "baseline": {"label": "Baseline Continuous test", "ids": ["11111111-1111-4111-8111-111111111111"]},
  "candidate": {"label": "Candidate Continuous test", "ids": ["22222222-2222-4222-8222-222222222222"]},
  "metrics": [
    {
      "name": "Selected session metric",
      "table": "session_metrics",
      "value_field": "measurement",
      "match": {"displayName": "CPU"},
      "group_by": ["instance", "fieldName", "unit"],
      "unit": "%",
      "semantics": "resource",
      "direction": "lower"
    }
  ]
}
